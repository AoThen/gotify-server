# Gotify 环境变量配置模板
# 
# 配置说明：
# - Tiered rate limiting: 分层速率限制（4层）
# - Authentication blacklist: 认证失败黑名单
# - Docker security: 非root用户、只读文件系统、资源限制
#
# 用法：
#   1. 复制为 .env: cp docker-compose.env.example .env
#   2.修改.env中的默认密码！
#   3. 启动：docker-compose up -d
#
# ⚠️ 安全提醒：
#   生产环境必须修改 GOTIFY_DEFAULTUSER_PASS！
#   白名单IP不受限制，需谨慎配置（支持CIDR格式）

# =============================================
# 基础配置
# =============================================
GOTIFY_SERVER_PORT=80

# =============================================
# Level 1: 全局速率限制（所有请求）
# =============================================
GOTIFY_SERVER_RATELIMIT_GLOBAL_ENABLED=true
GOTIFY_SERVER_RATELIMIT_GLOBAL_REQUESTSPERSECOND=20
GOTIFY_SERVER_RATELIMIT_GLOBAL_BURST=50

# =============================================
# Level 2: 认证API速率限制（Client Token + Admin）
# =============================================
GOTIFY_SERVER_RATELIMIT_AUTH_ENABLED=true
GOTIFY_SERVER_RATELIMIT_AUTH_REQUESTSPERSECOND=10
GOTIFY_SERVER_RATELIMIT_AUTH_BURST=20

# =============================================
# Level 3: 消息发送速率限制（Application Token）
# =============================================
GOTIFY_SERVER_RATELIMIT_MESSAGE_ENABLED=true
GOTIFY_SERVER_RATELIMIT_MESSAGE_REQUESTSPERSECOND=15
GOTIFY_SERVER_RATELIMIT_MESSAGE_BURST=30

# =============================================
# Level 4: 管理API速率限制（Admin Token）
# =============================================
GOTIFY_SERVER_RATELIMIT_ADMIN_ENABLED=true
GOTIFY_SERVER_RATELIMIT_ADMIN_REQUESTSPERSECOND=5
GOTIFY_SERVER_RATELIMIT_ADMIN_BURST=10

# =============================================
# 认证黑名单配置
# =============================================
GOTIFY_SERVER_AUTHBLACKLIST_ENABLED=true
GOTIFY_SERVER_AUTHBLACKLIST_MAXFAILURES=5
GOTIFY_SERVER_AUTHBLACKLIST_WINDOWSECONDS=300
GOTIFY_SERVER_AUTHBLACKLIST_BLOCKDURATION=3600
GOTIFY_SERVER_AUTHBLACKLIST_CLEANUPINTERVAL=300

# 白名单IP（CIDR格式）
GOTIFY_SERVER_AUTHBLACKLIST_WHITELIST_0=127.0.0.1
GOTIFY_SERVER_AUTHBLACKLIST_WHITELIST_1=192.168.1.0/24

# =============================================
# 数据库配置
# =============================================
GOTIFY_DATABASE_DIALECT=sqlite3
GOTIFY_DATABASE_CONNECTION=/gotify/data/gotify.db

# =============================================
# 默认用户（⚠️ 必须修改密码！）
# =============================================
GOTIFY_DEFAULTUSER_NAME=admin
GOTIFY_DEFAULTUSER_PASS=admin

# =============================================
# 其他配置
# =============================================
GOTIFY_PASSSTRENGTH=12
GOTIFY_REGISTRATION=false
GOTIFY_UPLOADEDIMAGESDIR=/gotify/data/images/
GOTIFY_PLUGINSDIR=/gotify/plugins/

# =============================================
# 数据目录
# =============================================
GOTIFY_DATA_PATH=./data

# =============================================
# 信任的代理服务器
# =============================================
# GOTIFY_SERVER_TRUSTEDPROXIES_0=172.16.0.0/12
# GOTIFY_SERVER_TRUSTEDPROXIES_1=192.168.0.0/16

# =============================================
# SSL/TLS（生产环境启用）
# =============================================
# GOTIFY_SERVER_SSL_ENABLED=true
# GOTIFY_SERVER_SSL_REDIRECTTOHTTPS=true
# GOTIFY_SERVER_SSL_CERTFILE=/gotify/ssl/cert.pem
# GOTIFY_SERVER_SSL_CERTKEY=/gotify/ssl/key.pem
# GOTIFY_SERVER_SSL_LETSENCRYPT_ENABLED=true
# GOTIFY_SERVER_SSL_LETSENCRYPT_ACCEPTTOS=true
# GOTIFY_SERVER_SSL_LETSENCRYPT_CACHE=/gotify/data/certs
# GOTIFY_SERVER_SSL_LETSENCRYPT_HOSTS=gotify.example.com
